{
  "name": "jaana",
  "version": "0.2.0",
  "private": true,
  "packageManager": "bun@1.3.5",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "vite",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "build": "bun build ./src/index.ts --outdir ./dist --target browser --format esm",
    "build:demo": "vite build",
    "site:examples": "bun run scripts/site-examples.ts",
    "build:gazetteer": "bun run scripts/build-gazetteer.ts",
    "train:tagger": "bun run scripts/train-tagger.ts",
    "explainer:snapshot": "bun run scripts/explainer-snapshot.ts",
    "bench": "bun run bench/run.ts",
    "bench:tagger": "bun run bench/run-tagger.ts",
    "bench:list": "bun run bench/run-list.ts",
    "bench:fixture": "bun run bench/run-fixture.ts"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "typescript": "7.0.2",
    "vite": "^8.1.4"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
